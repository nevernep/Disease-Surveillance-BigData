DATA_GO_TH_TOKEN=

# Local development only. Copy to .env and replace these values for shared environments.
S3_ACCESS_KEY=surveillance-local
S3_SECRET_KEY=surveillance-local-secret
DATA_LAKE_BUCKET=disease-surveillance
AIRFLOW_DB_PASSWORD=airflow-local-only
AIRFLOW_ADMIN_USER=airflow
AIRFLOW_ADMIN_PASSWORD=airflow-local-only
# Optional: generate a Fernet key for persistent Airflow connections.
AIRFLOW_FERNET_KEY=
AIRFLOW_SECRET_KEY=local-development-secret-key
# false = cases-only mode (skip population, incidence rate blank). true = fail when population CSVs are missing.
REQUIRE_POPULATION=false
# Spark reads raw/ and writes processed/ Parquet on the lake. Leave empty (DATA_LAKE_URI=) for local-file mode.
DATA_LAKE_URI=s3a://disease-surveillance
# PostgreSQL Data Warehouse (Power BI: localhost:5433, database surveillance_dw)
WAREHOUSE_DB_NAME=surveillance_dw
WAREHOUSE_DB_USER=dw_user
WAREHOUSE_DB_PASSWORD=warehouse-local-only
# Spark driver heap. Raise (e.g. 2g) only if Docker Desktop has >= 6 GB RAM.
SPARK_DRIVER_MEMORY=1g
